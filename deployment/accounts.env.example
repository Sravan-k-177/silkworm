NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=/var/lib/silksense
AUTH_MODE=accounts
# Replace with output from: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Must match the Caddy DOMAIN, without a trailing slash.
PUBLIC_ORIGIN=https://silksense.example.org
MODEL_URL=http://127.0.0.1:8791
